# Heartfolio — environment variables
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local or any file containing actual secret values — it is
# git-ignored (see .gitignore) for exactly this reason.

# ---------------------------------------------------------------------
# Django backend
# ---------------------------------------------------------------------
# Server-side only, and deliberately NOT prefixed NEXT_PUBLIC_: the browser
# never talks to this origin directly. It calls the same-origin path
# /api/backend/*, which next.config.ts rewrites here server-side, keeping
# the Django guest session cookie first-party. See the rewrite block in
# next.config.ts for why that matters.
#
# REQUIRED — there is no default, and empty counts as unset. `next dev` and
# `next build` refuse to start without it, and the server-side catalog and
# live-page fetches throw an explicit error naming this variable. (It used to
# fall back to a hardcoded Railway URL, a host this project no longer uses.)
# Use http://localhost:8000 against a local Django (http://api:8000 under
# docker compose); on the planned VPS, that backend's address. No path.
BACKEND_API_ORIGIN=

# The same-origin path the browser calls. Almost never needs setting;
# the default (/api/backend) is correct for localhost, preview deployments
# and production alike.
# NEXT_PUBLIC_API_BASE_PATH=/api/backend

# Supabase project URL backing the waitlist API route
# (src/app/api/waitlist/route.ts).
SUPABASE_URL=

# Supabase service-role key. Server-side only — this key bypasses Row
# Level Security. Never expose it to the client and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Paddle (client-side only)
# ---------------------------------------------------------------------
# Which Paddle environment the browser SDK talks to: "sandbox" or
# "production". Public and non-secret. Defaults to "sandbox" when unset,
# deliberately — a missing variable must never point a test at live
# payments.
#
# The Paddle CLIENT TOKEN is NOT here: it arrives in the response to
# POST /orders/{id}/pay/, so the sandbox-to-production switch is a
# backend concern. The Paddle API key and webhook secret are server-side
# only and must never appear in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Freemius (sandbox review build) — orthogonal to the Paddle/FastSpring
# switch above, on purpose. Freemius is being trialled for a Merchant-of-
# Record review (provisionally accepted, not yet confirmed) and its
# checkout has no passthrough field to resolve a webhook back to a
# pending order, so it uses its own staging flow
# (src/lib/studio/engines/checkout-engine.ts's waitForStagedOrder,
# src/lib/commerce/freemius-client.ts) instead of the existing
# prepareOrder/startPayment path. Off by default — a missing variable
# must never silently switch checkout to an unconfirmed provider.
NEXT_PUBLIC_FREEMIUS_ENABLED=false

# §6 — the Love Story Timeline's milestone location search. Client-side by
# design (see lib/api/mapbox.ts); restrict it to your domain in the Mapbox
# dashboard rather than trying to keep it secret. Without this set, the
# location field degrades to a disabled state rather than firing requests
# that would 401.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
