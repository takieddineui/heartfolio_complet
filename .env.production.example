# Heartfolio production environment: copy to `.env.production` on the VPS,
# fill in, and never commit the copy (.gitignore keeps every .env.* out
# except this names-only template). DEPLOYMENT-VPS.md explains each group.
#
# One file feeds three things in docker-compose.prod.yml:
#   - the api container's environment (every line),
#   - the web image's BUILD args (the NEXT_PUBLIC_* lines; a change needs a
#     rebuild of `web`, not a restart),
#   - Caddy's host names (SITE_HOST, APEX_HOST, API_HOST, ACME_EMAIL).

# ---------------------------------------------------------------------
# Hosts (Caddy and Django)
# ---------------------------------------------------------------------
SITE_HOST=www.theheartfolio.com
APEX_HOST=theheartfolio.com
API_HOST=api.theheartfolio.com
# Let's Encrypt contacts this address about the certificates.
ACME_EMAIL=

# `api` is the name the web container uses to reach Django internally.
DJANGO_ALLOWED_HOSTS=api.theheartfolio.com,api
CORS_ALLOWED_ORIGINS=https://www.theheartfolio.com
# Defaults to CORS_ALLOWED_ORIGINS when unset.
CSRF_TRUSTED_ORIGINS=https://www.theheartfolio.com,https://api.theheartfolio.com
# Every emailed link and every printed QR code points here.
FRONTEND_URL=https://www.theheartfolio.com
# Links in the ops digest email (send_digest).
BACKEND_PUBLIC_URL=https://api.theheartfolio.com

# ---------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------
# A long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
DJANGO_SECRET_KEY=
# Caddy redirects HTTP to HTTPS for every public request, and the api
# container is reachable over plain HTTP only from inside the Docker network
# (the web container's server-side calls). Django's own redirect would bounce
# those internal calls, so it is OFF here; HSTS is still sent on HTTPS
# requests (DJANGO_SECURE_HSTS_SECONDS, default 30 days).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Supabase, session-mode pooler (see CLAUDE.md: transaction mode is not
# supported by this project's settings).
DATABASE_URL=

# ---------------------------------------------------------------------
# Payments: Freemius only
# ---------------------------------------------------------------------
# PAYMENT_PROVIDER defaults to `freemius` in production; leave it unset.
FREEMIUS_ENABLED=true
# Production runs Freemius LIVE only: production settings refuse to start
# with FREEMIUS_ENABLED=true unless this is true too, the checkout then offers
# no sandbox mode, and the server refuses sandbox licences. Sandbox checkouts
# are run on local Docker (DEPLOYMENT-VPS.md, section 5).
FREEMIUS_LIVE_CONFIRMED=true
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
# The web image's build arg: the storefront opens the Freemius checkout.
NEXT_PUBLIC_FREEMIUS_ENABLED=true

# Paddle and FastSpring stay in the code, switched off. Leave every PADDLE_*
# and FASTSPRING_* variable unset: their webhooks then reject all requests.

# ---------------------------------------------------------------------
# Asset storage (Cloudflare R2)
# ---------------------------------------------------------------------
ASSET_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
# Photo bytes held in memory per worker while rendering (code default 64;
# at 8 photos of 73MB the default overflowed and photos were read 97 times).
ASSET_BYTES_CACHE_MAX_MB=128

# ---------------------------------------------------------------------
# Email (Resend) and alerts (Telegram)
# ---------------------------------------------------------------------
RESEND_API_KEY=
# The domain must be verified in Resend, or every receipt is rejected.
RESEND_FROM_EMAIL=no-reply@theheartfolio.com
RESEND_REPLY_TO_EMAIL=support@theheartfolio.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Frontend build args (inlined at build time: rebuild `web` to change)
# ---------------------------------------------------------------------
# Location search in the Love Story Timeline Studio. Without it the Studio
# says location search is unavailable.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Google Analytics 4 (G-XXXXXXX): loaded only after a visitor accepts the
# cookie banner.
NEXT_PUBLIC_GA_ID=
# Optional cookieless analytics, e.g. theheartfolio.com. Empty: not loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------
# Gunicorn (the api container)
# ---------------------------------------------------------------------
# Each worker is a full Django process; a heavy pack render has been
# measured above 512MB. About one worker per GB of free memory.
GUNICORN_WORKERS=2
# Matches the frontend proxy's timeout, which is baked into the web image.
GUNICORN_TIMEOUT=120
# Recycle a worker after this many requests (plus up to the jitter) so
# render caches cannot grow without bound.
GUNICORN_MAX_REQUESTS=200
GUNICORN_MAX_REQUESTS_JITTER=50

# ---------------------------------------------------------------------
# Optional: rate limits (production defaults shown)
# ---------------------------------------------------------------------
# THROTTLE_RATE_GUEST_IDENTITY=20/min
# THROTTLE_RATE_ASSET_UPLOAD=30/min
# THROTTLE_RATE_ORDER_CREATE=20/min
# THROTTLE_RATE_DELIVERY_DOWNLOAD=60/min
# THROTTLE_RATE_FEEDBACK_CREATE=10/min
# THROTTLE_RATE_AR_ACCESS=1000/min   (not tightened: the live page fetches from the Next server, one shared identity)
# THROTTLE_RATE_AR_TARGET_UPLOAD=60/min
# THROTTLE_RATE_YOUTUBE_VALIDATE=30/min
