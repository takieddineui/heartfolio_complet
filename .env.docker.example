# ============================================================
# HEARTFOLIO LOCAL DOCKER ENVIRONMENT — EXAMPLE
# ============================================================

# ----------------------------
# Django
# ----------------------------

DJANGO_SECRET_KEY=local-dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SETTINGS_MODULE=config.settings.development

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000


# ----------------------------
# Database
# ----------------------------

# Normal Docker application uses Supabase.
# Replace with your Supabase DATABASE_URL in .env.docker.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/YOUR_DATABASE


# ----------------------------
# Payments
# ----------------------------

PAYMENT_PROVIDER=mock
PADDLE_ENVIRONMENT=sandbox

# Optional for deliberate Paddle Sandbox API testing.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Optional for deliberate FastSpring Sandbox testing (PAYMENT_PROVIDER=fastspring).
# One store/one credential pair serves both test and live mode — there is
# no separate sandbox credential set the way Paddle has.
FASTSPRING_ENVIRONMENT=sandbox
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
FASTSPRING_ACCESS_KEY=
FASTSPRING_WEBHOOK_SECRET=
FASTSPRING_STORE_ID=heartfolio
FASTSPRING_CHECKOUT_ID=popup-heartfolio

# Freemius (sandbox review build) — orthogonal to PAYMENT_PROVIDER above,
# not a value for it. Independently-flippable: FREEMIUS_ENABLED can be
# true while PAYMENT_PROVIDER stays "mock"/"paddle"/"fastspring" for
# everything else. FREEMIUS_API_TOKEN and FREEMIUS_SECRET_KEY are two
# DIFFERENT credentials (Settings -> API & Keys in the Developer
# Dashboard) — the token authenticates our server's REST calls, the
# secret key verifies inbound webhook signatures. FREEMIUS_PUBLIC_KEY is
# not secret — it goes straight into the browser's checkout call.
FREEMIUS_ENABLED=false
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=

# No separate sandbox token/ctx setting: `getSandboxParams()` (Freemius's
# own SDK, verified against its published source) makes no REST call —
# it's `md5(timestamp + product_id + secret_key + public_key + "checkout")`,
# computed fresh per request from the three values above. See
# FreemiusStagingSerializer.get_sandbox, which also refuses to compute one
# at all once FREEMIUS_LIVE_CONFIRMED=true.

# Second, deliberate switch beyond FREEMIUS_ENABLED — production.py
# refuses to boot with Freemius enabled unless this is also true. Stays
# false until Freemius actually confirms the account past provisional
# acceptance.
FREEMIUS_LIVE_CONFIRMED=false


# ----------------------------
# Cloudflare R2
# ----------------------------

ASSET_STORAGE_BACKEND=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heartfolio
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
# Optional tuning for server-side photo reads (pack renders). Defaults are
# shown; leave commented unless you have measured a reason to change them.
# R2_CONNECT_TIMEOUT_SECONDS=5
# R2_READ_TIMEOUT_SECONDS=15
# R2_DOWNLOAD_DEADLINE_SECONDS=45
# R2_DOWNLOAD_ATTEMPTS=3
# Per-request photo cache. 64 is the code default. A story of 8 milestones from a
# modern phone can exceed 64MB of photos, and past the cap the same photos are
# read from R2 again (measured: 97 reads for 8 photos at 73MB). Use 128 when the
# Studio allows 8 milestones. Applies only when the container is CREATED
# (`docker compose up -d --force-recreate api`), not on `restart`.
# ASSET_BYTES_CACHE_MAX_MB=64
# ASSET_PREFETCH_WORKERS=6
# ASSET_PREFETCH_BUDGET_SECONDS=50
# ASSET_READ_BUDGET_SECONDS=90   # keep well under gunicorn --timeout (120)


# ----------------------------
# Email
# ----------------------------

# Leave blank for local development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# ----------------------------
# Telegram
# ----------------------------

# Leave blank for local development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ============================================================
# FRONTEND / NEXT.JS
# ============================================================

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Docker web → Docker api
BACKEND_API_ORIGIN=http://api:8000

NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_FREEMIUS_ENABLED=false