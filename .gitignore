# =====================================================================
# Heartfolio monorepo .gitignore
# Anything listed here never reaches GitHub. Check with:
#   git status --ignored      (what is being ignored)
#   git ls-files              (what will actually be committed)
# =====================================================================

# --- Secrets: real values must never be tracked ----------------------
# Every .env* file holds real values, EXCEPT the names-only templates
# explicitly un-ignored at the end of this block.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.docker.example
!**/.env.docker.example
!.env.production.example

# SSH keys and certificates (a private key sits in ./.ssh)
.ssh/
**/.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
*.pem
*.key
*.p12
*.pfx
*.crt

# Push scripts: they hold or invoke a personal access token
push.bat
**/push.bat

# Credentials and tool state
*.token
secrets/
credentials*.json
service-account*.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# Backups of the old per-folder repos (full history, may hold old secrets)
.git.bak/
**/.git.bak/

# --- Stray artifacts --------------------------------------------------
# A folder literally named "backend;C" (a mangled-path accident)
backend;C/
verify-git.bat

# --- Dependencies and build output ------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Python / Django --------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
staticfiles/
media/
*.sqlite3
db.sqlite3
.pytest_cache/
.coverage
htmlcov/

# --- Docker -----------------------------------------------------------
# Local database volumes, if any are ever bind-mounted
pgdata/
postgres-data/
*.dump

# --- Logs, editors, OS ------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db
