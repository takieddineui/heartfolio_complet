            "place": "LONDON"
          },
          {
            "title": "Exchange year",
            "detail": "And surprisingly good Danish",
            "place": "COPENHAGEN"
          },
          {
            "title": "Society president",
            "detail": "Forty sketchers, one sketchbook",
            "place": "STUDIO 4"
