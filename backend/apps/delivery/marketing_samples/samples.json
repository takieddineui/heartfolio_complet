        "messagesEnabled": true,
        "messageGroups": [
          {
            "label": "From home",
            "people": [
              {
                "name": "Mum",
                "color": "coral",
                "emoji": "🏡",
                "message": "I still have every drawing you ever stuck on the fridge. Now I get to see your buildings on real streets. I am so, so proud of you."
              },
              {
                "name": "Dad",
                "color": "sky",
                "emoji": "☕",
                "message": "You worked harder than anyone I know, and you stayed kind while you did it. That's the real achievement. Well done, kiddo."
              },
              {
                "name": "Kai",
                "color": "amber",
                "emoji": "🌳",
                "message": "Can you design me a treehouse with a slide. And a zip line. Well done Maya."
              }
            ]
          },
          {
            "label": "From friends",
            "people": [
              {
                "name": "Jonah",
                "color": "mint",
                "emoji": "✏️",
                "message": "Four years of sharing a desk, a kettle and about a thousand deadlines. Copenhagen has no idea what is coming. So proud of you!"
              },
              {
                "name": "Priya",
                "color": "berry",
                "emoji": "🎉",
                "message": "You're the only person I know who sketches the queue at the supermarket. Never stop. Love you, superstar."
              },
              {
                "name": "Sam",
                "color": "violet",
                "emoji": "🏫",
                "message": "From drawing on the walls to designing actual walls. Ten-year-old me would be very impressed."
              }
            ]
          }
        ],
        "goalsEnabled": true,
        "goals": [
          {
            "text": "Start at the studio in Copenhagen",
            "code": "CPH"
          },
          {
            "text": "Become a fully qualified architect",
            "code": "ARB"
          },
          {
            "text": "Learn to cycle in Copenhagen without getting lost",
            "code": "BKE"
          },
          {
            "text": "Build Kai that treehouse",
            "code": "TRE"
          },
          {
            "text": "Visit every Alvar Aalto building",
            "code": "AAL"
          }
        ],
        "letterEnabled": true,
        "letterGreeting": "Dear Maya,",
        "letterParagraphs": [
          {
            "text": "Today you are wearing a cap and gown, but we still see the little girl with crayon all over her hands, explaining exactly where the front door of her house would go."
          },
          {
            "text": "You did this through late nights, hard days and more toast than any person should eat. We could not be prouder of who you have become."
          },
          {
            "text": "The world is about to get a little more beautiful. Go and build it."
          }
        ],
        "letterSignoff": "With all our love,",
        "letterSignatures": [
          {
            "name": "Mum"
          },
          {
            "name": "Dad"
          },
          {
            "name": "Kai"
          }
        ],
