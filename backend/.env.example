# Copy to .env for local development. Never commit the real .env file.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
HEARTFOLIO_LOG_LEVEL=INFO

# --- Database ---
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heartfolio

# --- CORS ---
# Comma-separated list of origins the Next.js Studio is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Guest session / CSRF (see config/settings/base.py) ---
# Comma-separated. Defaults to CORS_ALLOWED_ORIGINS if unset.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
# "Lax" is correct when frontend/backend share a registrable domain
# (including different localhost ports). Use "None" only if they are on
# genuinely unrelated domains — requires Secure, so only take effect
# together with the production block below.
# DJANGO_SESSION_COOKIE_SAMESITE=Lax
# DJANGO_CSRF_COOKIE_SAMESITE=Lax
# Guest session lifetime in seconds. Default: 30 days.
# DJANGO_SESSION_COOKIE_AGE=2592000

# --- Production-only (see config/settings/production.py) ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Asset storage / Cloudflare R2 (see config/settings/base.py) ---
# "mock" = in-memory, no credentials needed (default; used for local
# dev and the entire test suite). "r2" = real Cloudflare R2 — required
# in production, which will refuse to start if any R2_* value below is
# missing.
ASSET_STORAGE_BACKEND=mock
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Leave blank to derive from R2_ACCOUNT_ID: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Only set this if the bucket is intentionally public (e.g. a CDN
# domain in front of it). Leave blank to use short-lived presigned URLs
# instead — the normal MVP path.
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_EXPIRY_SECONDS=300
# Optional tuning for server-side photo reads (pack renders). Defaults are
# shown; leave commented unless you have measured a reason to change them.
# R2_CONNECT_TIMEOUT_SECONDS=5
# R2_READ_TIMEOUT_SECONDS=15
# R2_DOWNLOAD_DEADLINE_SECONDS=45
# R2_DOWNLOAD_ATTEMPTS=3
# Per-request photo cache. 64 is the code default. 8 milestones from a modern
# phone can exceed 64MB of photos, and past the cap the same photos are read from
# R2 again (measured: 97 reads for 8 photos at 73MB). Use 128 for 8 milestones.
# ASSET_BYTES_CACHE_MAX_MB=64
# ASSET_PREFETCH_WORKERS=6
# ASSET_PREFETCH_BUDGET_SECONDS=50
# ASSET_READ_BUDGET_SECONDS=90   # keep well under gunicorn --timeout (120)

# Max upload size in MB, and comma-separated allowed MIME types.
MAX_ASSET_SIZE_MB=10
# §5 — optional milestone video/audio. Separate, larger ceiling: the image
# limit above would reject a few seconds of phone video.
MAX_MEDIA_SIZE_MB=50
MEDIA_REENCODE_TIMEOUT_SECONDS=60
# §7 — how long an unpurchased video/audio upload survives before the
# expiry sweep (`manage.py expire_provisional_assets`) deletes it.
MEDIA_PROVISIONAL_RETENTION_DAYS=7
# Ceiling on a project's serialized `data` payload (§22b).
MAX_PROJECT_DATA_KB=256

# Transactional email (§12). Sending is skipped with a warning when the key
# is blank, so local and CI runs never attempt a real send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@theheartfolio.com
# Where emailed magic links point.
FRONTEND_URL=https://www.theheartfolio.com
# How long an emailed order link stays valid.
ORDER_ACCESS_TOKEN_MAX_AGE_DAYS=30
# §9 — where the Telegram digest's "Reports"/"Status" buttons point (this
# app's own public address). Empty by default; the digest omits the
# buttons rather than sending a broken link when unset.
BACKEND_PUBLIC_URL=

# i18n
SUPPORTED_LOCALES=en,fr,ar
DEFAULT_LOCALE=en

# §9 — Telegram alerts. Create a bot with @BotFather, then message it once
# and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Leave blank to disable alerting entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ASSET_MIME_TYPES=image/jpeg,image/png,image/webp

# --- Payments / Paddle Billing (see config/settings/base.py) ---
# "mock" = MockPaymentProvider, no credentials needed (default; used
# for local dev and the entire test suite). "paddle" = real Paddle
# Billing — required in production, which will refuse to start if any
# PADDLE_* value below is missing, and will also refuse to start with
# PAYMENT_PROVIDER=mock.
PAYMENT_PROVIDER=mock
# "sandbox" (Paddle Sandbox — separate credentials/data from live,
# no real payments) or "production".
PADDLE_ENVIRONMENT=sandbox
# Secret. Backend-only — used to call the Paddle API. Never sent to
# the frontend, never logged.
PADDLE_API_KEY=
# Public. Safe to embed in frontend code for Paddle.js to open
# Checkout — this is not a secret by Paddle's own design.
PADDLE_CLIENT_TOKEN=
# Secret. Backend-only — used only to verify the HMAC signature on
# incoming webhooks at /api/v1/webhooks/paddle/.
PADDLE_WEBHOOK_SECRET=

# --- Payments / FastSpring (see config/settings/base.py) ---
# Sandbox integration; Paddle remains the live default above. Only
# matters once PAYMENT_PROVIDER=fastspring is deliberately set — same
# "required in production, refuses to start if missing" rule as Paddle.
# One store/one credential pair serves both test and live mode — there
# is no separate sandbox credential set the way Paddle has.
FASTSPRING_ENVIRONMENT=sandbox
# Secret. Backend-only — HTTP Basic Auth for the Sessions API.
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
# Public. Safe to embed in frontend code for the Store Builder Library
# to open checkout — not a secret by FastSpring's own design.
FASTSPRING_ACCESS_KEY=
# Secret. Backend-only — used only to verify the HMAC signature on
# incoming webhooks at /api/v1/webhooks/fastspring/.
FASTSPRING_WEBHOOK_SECRET=
# Confirmed account values — see apps/commerce/fastspring_integration.py.
FASTSPRING_STORE_ID=heartfolio
FASTSPRING_CHECKOUT_ID=popup-heartfolio

# --- DRF throttle rates (see config/settings/base.py, REST_FRAMEWORK) ---
# All default to 1000/min (effectively off) except the two noted below,
# which have tighter production-appropriate defaults of their own.
THROTTLE_RATE_GUEST_IDENTITY=1000/min
THROTTLE_RATE_ASSET_UPLOAD=1000/min
THROTTLE_RATE_ORDER_CREATE=1000/min
THROTTLE_RATE_DELIVERY_DOWNLOAD=1000/min
THROTTLE_RATE_FEEDBACK_CREATE=1000/min
THROTTLE_RATE_AR_ACCESS=1000/min
# §21i — a write endpoint, so tighter than the read ones.
THROTTLE_RATE_AR_TARGET_UPLOAD=60/min
# Song Poster's YouTube embeddability check — an outbound call, same
# reasoning as ar_target_upload.
THROTTLE_RATE_YOUTUBE_VALIDATE=30/min
